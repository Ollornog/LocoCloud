#!/usr/bin/env python3
# ============================================
# GENERIERT DURCH ANSIBLE — NICHT MANUELL EDITIEREN
# Documenso → Paperless Bridge
# Laedt fertig signierte Dokumente aus Documenso und legt sie
# im Paperless consume-Ordner ab.
# Generiert: {{ ansible_facts.date_time.iso8601 }}
# ============================================
"""
Polls Documenso API for completed documents, downloads signed PDFs,
and places them in Paperless consume directory for automatic archival.

Uses only Python stdlib (no external dependencies).
"""

import json
import os
import sys
import urllib.request
import urllib.error
import logging
from pathlib import Path
from datetime import datetime

# --- Configuration ---
API_URL = "{{ documenso_paperless_api_url }}"
API_TOKEN = "{{ documenso_paperless_api_token }}"
CONSUME_PATH = "{{ documenso_paperless_consume_path }}"
STATE_FILE = "{{ documenso_paperless_state_file }}"
FILE_PREFIX = "{{ documenso_paperless_file_prefix }}"

logging.basicConfig(
    level=logging.INFO,
    format="[%(asctime)s] %(levelname)s: %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
)
log = logging.getLogger("documenso-paperless")


def api_request(path: str) -> urllib.request.Request:
    """Build an authenticated API request."""
    url = f"{API_URL}{path}"
    req = urllib.request.Request(url)
    req.add_header("Authorization", f"Bearer {API_TOKEN}")
    return req


def load_synced_ids() -> set:
    """Load already-synced document IDs from state file."""
    try:
        with open(STATE_FILE, "r") as f:
            return set(line.strip() for line in f if line.strip())
    except FileNotFoundError:
        return set()


def save_synced_id(doc_id: str) -> None:
    """Append a synced document ID to the state file."""
    with open(STATE_FILE, "a") as f:
        f.write(f"{doc_id}\n")


def get_completed_documents() -> list:
    """Fetch all completed documents from Documenso API."""
    try:
        req = api_request("/api/v1/documents")
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        log.error("API error listing documents: %s %s", e.code, e.reason)
        return []
    except Exception as e:
        log.error("Failed to list documents: %s", e)
        return []

    # Documenso API returns { documents: [...] } or directly [...]
    docs = data if isinstance(data, list) else data.get("documents", data.get("data", []))

    completed = []
    for doc in docs:
        status = doc.get("status", "")
        if status == "COMPLETED":
            completed.append(doc)

    return completed


def download_document(doc_id: str, title: str) -> bool:
    """Download a completed document PDF and save to Paperless consume."""
    try:
        # Documenso API: download completed document as PDF
        req = api_request(f"/api/v1/documents/{doc_id}/download")
        with urllib.request.urlopen(req, timeout=60) as resp:
            pdf_data = resp.read()
    except urllib.error.HTTPError as e:
        log.error("Failed to download document %s: %s %s", doc_id, e.code, e.reason)
        return False
    except Exception as e:
        log.error("Download error for document %s: %s", doc_id, e)
        return False

    if len(pdf_data) < 100:
        log.warning("Document %s seems too small (%d bytes), skipping", doc_id, len(pdf_data))
        return False

    # Sanitize filename
    safe_title = "".join(c if c.isalnum() or c in " -_.()" else "_" for c in title)
    safe_title = safe_title.strip()[:200] or f"document-{doc_id}"
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"{FILE_PREFIX}_{safe_title}_{timestamp}.pdf"
    filepath = os.path.join(CONSUME_PATH, filename)

    try:
        with open(filepath, "wb") as f:
            f.write(pdf_data)
        # Ensure Paperless (UID 1000) can read and delete the file
        os.chmod(filepath, 0o666)
        log.info("Saved: %s (%d bytes)", filename, len(pdf_data))
        return True
    except Exception as e:
        log.error("Failed to save %s: %s", filepath, e)
        return False


def main() -> int:
    if not API_TOKEN:
        log.error("No API token configured. Set documenso_paperless_api_token.")
        return 1

    if not os.path.isdir(CONSUME_PATH):
        log.error("Consume directory does not exist: %s", CONSUME_PATH)
        return 1

    synced_ids = load_synced_ids()
    completed = get_completed_documents()

    if not completed:
        log.debug("No completed documents found")
        return 0

    new_count = 0
    for doc in completed:
        doc_id = str(doc.get("id", ""))
        if not doc_id or doc_id in synced_ids:
            continue

        title = doc.get("title", doc.get("name", f"document-{doc_id}"))
        log.info("New completed document: %s (ID: %s)", title, doc_id)

        if download_document(doc_id, title):
            save_synced_id(doc_id)
            new_count += 1

    if new_count > 0:
        log.info("Synced %d new document(s) to Paperless", new_count)

    return 0


if __name__ == "__main__":
    sys.exit(main())
