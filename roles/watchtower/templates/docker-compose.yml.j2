# ============================================
# GENERIERT DURCH ANSIBLE — NICHT MANUELL EDITIEREN
# Watchtower — Automatic Docker image updates
# Generiert: {{ ansible_facts.date_time.iso8601 }}
# ============================================

services:
  watchtower:
    image: {{ watchtower_image }}
    container_name: watchtower
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      WATCHTOWER_CLEANUP: "{{ watchtower_cleanup | string | lower }}"
      WATCHTOWER_SCHEDULE: "{{ watchtower_schedule }}"
{% if watchtower_label_enable %}
      WATCHTOWER_LABEL_ENABLE: "true"
{% endif %}
{% if watchtower_notifications_enabled %}
      WATCHTOWER_NOTIFICATIONS: "email"
      WATCHTOWER_NOTIFICATION_EMAIL_FROM: "{{ watchtower_smtp_from }}"
      WATCHTOWER_NOTIFICATION_EMAIL_TO: "{{ watchtower_smtp_to }}"
      WATCHTOWER_NOTIFICATION_EMAIL_SERVER: "{{ watchtower_smtp_host }}"
      WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PORT: "{{ watchtower_smtp_port }}"
      WATCHTOWER_NOTIFICATION_EMAIL_SERVER_USER: "{{ watchtower_smtp_user }}"
      WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD: "{{ watchtower_smtp_password | default('') }}"
{% endif %}
      TZ: "{{ timezone | default('Europe/Vienna') }}"
