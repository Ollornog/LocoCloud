---
# inventories/kunde-{{ kunde_id }}/group_vars/all.yml
# Customer: {{ kunde_name }}
# Generated by: scripts/new-customer.sh

# --- Customer identity ---
kunde_name: "{{ kunde_name }}"
kunde_domain: "{{ kunde_domain }}"
kunde_id: "{{ kunde_id }}"

# --- Isolation ---
isolation_mode: "single_lxc"         # single_lxc | lxc_per_app

# --- Admin user ---
admin_user: "srvadmin"
admin_ssh_pubkeys: []  # Add master SSH public key

# --- Netbird ---
netbird_setup_key: "{{ '{{ vault_netbird_setup_key }}' }}"
netbird_group: "kunde-{{ kunde_id }}"

# --- Customer users ---
kunden_users: []
#  - username: "m.mustermann"
#    display_name: "Max Mustermann"
#    email: "m.mustermann@{{ kunde_domain }}"

kunden_emails: "{{ '{{ kunden_users | map(attribute=\\'email\\') | list }}' }}"

# --- Paperless group permissions ---
# paperless_group_permissions_enabled: true
# paperless_company_group: "{{ kunde_name }}"  # must match PocketID/LLDAP group
# paperless_views_template_user: ""            # copy saved views from this user

# --- Apps ---
apps_enabled: []
#  - name: "Nextcloud"
#    subdomain: "cloud"
#    port: 8080
#    image: "nextcloud:29"
#    oidc_enabled: true
#    oidc_redirect_path: "/apps/user_oidc/code"
#    needs_db: true
#    db_type: "mariadb"
#    needs_redis: true
#    redis_db: 0
#    public_paths:
#      - "/index.php/s/*"
#      - "/s/*"
#    backup_paths:
#      - "/mnt/data/nextcloud"

# --- Backup (3-2-1 Strategie) ---
backup:
  enabled: false
  schedule: "0 3 * * *"             # Taeglich um 03:00
  alert_email: ""                    # E-Mail bei Backup-Fehlern
  targets: []
  #  - name: "storagebox-nbg"
  #    host: "uXXXXX.your-storagebox.de"
  #    port: 23
  #    user: "uXXXXX-sub1"
  #    path: "/backup"
  #    ssh_key_name: "storagebox"
  #  - name: "storagebox-hel"
  #    host: "uYYYYY.your-storagebox.de"
  #    port: 23
  #    user: "uYYYYY-sub1"
  #    path: "/backup"
  #    ssh_key_name: "storagebox"
  ssh_keys: []
  #  - name: "storagebox"
  #    port: 23
  retention:
    keep_daily: 7
    keep_weekly: 4
    keep_monthly: 6
  check_schedule: "0 5 * * 0"       # Sonntag 05:00 — Repo-Integritaet
  restore_test:
    enabled: true
    schedule: "0 3 1 * *"           # Monatlich am 1. um 03:00

# --- DynDNS (optional) ---
dyndns:
  enabled: false
  provider: "master"
